# IGVC UDEV RULES
# You MUST replace the idVendor and idProduct values with your actual hardware IDs!
# Find them by plugging in the device and running: lsusb

# Arduino (Motors/Encoders) -> /dev/arduino
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", MODE:="0666", SYMLINK+="arduino"

# RPLidar -> /dev/rplidar
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", SYMLINK+="rplidar"

# BNO085 IMU -> /dev/imu
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE:="0666", SYMLINK+="imu"

# u-blox GPS -> /dev/gps
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a7", MODE:="0666", SYMLINK+="gps"
